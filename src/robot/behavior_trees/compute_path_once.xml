<!--
  This Behavior Tree computes the global path only once.
  After that, it follows the path using the local controller (e.g., MPPI)
  without replanning or recovery behaviors.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateOnce">
      <!-- Compute global path a single time -->
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>

      <!-- Follow the precomputed path -->
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </Sequence>
  </BehaviorTree>
</root>
