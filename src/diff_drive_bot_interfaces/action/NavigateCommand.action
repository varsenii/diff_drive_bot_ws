# Request

# Command types
uint8 MOVE = 0
uint8 ROTATE = 1
uint8 GO_TO_WAYPOINT = 2
uint8 GO_TO_LOCATION = 3 

uint8 command_type

# MOVE fields
float32 distance # Positive for forward, negative for backward

# ROTATE fields
float32 angle # Positive CCW, negative CW

# GO_TO_LOCATION fields
string location 

---
# Result
bool success
string message

---
#Feedback
string status
float32 progress  # 0.0 to 1.0